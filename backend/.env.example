# All variables are optional — the app runs keyless on SQLite with an
# in-process cache when nothing is set.

# Claude review provider (omit to use the deterministic rule-based analyzer)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5

# PostgreSQL (omit to use a local SQLite file)
# DATABASE_URL=postgresql+psycopg2://resume:resume@localhost:5432/resume_reviewer

# Redis response cache (omit to use the in-process TTL cache)
# REDIS_URL=redis://localhost:6379/0

# Auth
# JWT_SECRET=change-me-in-production
# JWT_EXPIRES_MINUTES=1440
